{
  "name": "cryteeq",
  "version": "0.5.0",
  "description": "Line-by-line file review tool with a pull-request-style UI",
  "type": "module",
  "private": true,
  "license": "BSD-3-Clause",
  "bin": {
    "cryteeq": "dist/server/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsup",
    "build:client": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite",
    "dev:server": "tsx watch src/server/cli.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "better-sqlite3": "^12.0.0",
    "fastify": "^5.0.0",
    "open": "^10.0.0",
    "react-markdown": "^10.1.0",
    "shiki": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
